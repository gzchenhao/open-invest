{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeepTech Global Policy Intelligence Schema",
  "description": "Comprehensive schema for storing and parsing global government policies for DeepTech investment, incentives, compliance requirements, and landing criteria - optimized for policy crawlers and data cleaning services",
  "type": "object",
  "properties": {
    "policy_metadata": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "description": "Unique identifier for the policy (UUID format recommended)"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Original URL of the policy document"
        },
        "jurisdiction": {
          "type": "object",
          "properties": {
            "country": {
              "type": "string",
              "description": "Country name (e.g., 'China', 'United States', 'Singapore')"
            },
            "region": {
              "type": "string",
              "description": "Region/State (e.g., 'California', 'Guangdong', 'Île-de-France')"
            },
            "city": {
              "type": "string",
              "description": "City (e.g., 'Shanghai', 'San Francisco', 'Singapore')"
            },
            "tech_hub": {
              "type": "string",
              "description": "Specific tech hub or special economic zone (e.g., 'Zhangjiang Science City', 'Silicon Valley', 'Shenzhen Special Economic Zone')"
            },
            "administrative_level": {
              "type": "string",
              "enum": ["national", "state", "provincial", "municipal", "special_zone", "local"],
              "description": "Administrative level of the policy"
            },
            "coordinates": {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            }
          },
          "required": ["country", "region", "city"]
        },
        "policy_type": {
          "type": "string",
          "enum": [
            "tax_incentive",
            "subsidy",
            "land_grant",
            "rdd_support",
            "compliance",
            "immigration",
            "infrastructure",
            "talent_attraction",
            "ip_protection",
            "market_access",
            "export_support",
            "regulatory_exemption",
            "incentive_package"
          ],
          "description": "Primary type of policy"
        },
        "policy_subtype": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Secondary policy types (e.g., ['startup_support', 'ai_friendly'])"
        },
        "effective_date": {
          "type": "string",
          "format": "date",
          "description": "When the policy becomes effective"
        },
        "expiration_date": {
          "type": ["string", "null"],
          "format": "date",
          "description": "When the policy expires (null if no expiration)"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "crawl_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the policy was crawled"
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score in the parsed data (0-1)"
        },
        "data_quality": {
          "type": "string",
          "enum": ["raw", "cleaned", "validated", "verified"],
          "description": "Data quality level after processing"
        },
        "language": {
          "type": "string",
          "default": "en",
          "description": "Language of the original policy document"
        },
        "currency": {
          "type": "string",
          "default": "USD",
          "description": "Primary currency for financial incentives"
        }
      },
      "required": ["policy_id", "jurisdiction", "policy_type", "effective_date", "crawl_timestamp"]
    },
    "target_industries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "industry": {
            "type": "string",
            "enum": [
              "ai_ml",
              "robotics",
              "quantum_computing",
              "biotech",
              "fintech",
              "cleantech",
              "aerospace",
              "semiconductor",
              "blockchain",
              "vr_ar",
              "nanotech",
              "space_tech",
              "embodied_ai",
              "autonomous_driving",
              "cybersecurity",
              "iot",
              "5g",
              "edge_computing",
              "metaverse",
              "web3",
              "digital_twin"
            ]
          },
          "priority_level": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "specific_focus": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Specific focus areas within the industry (e.g., ['generative_ai', 'autonomous_navigation'])"
          },
          "TRL_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["concept", "prototype", "pilot", "production", "commercial"]
            },
            "description": "Technology Readiness Level requirements"
          }
        }
      }
    },
    "incentives": {
      "type": "object",
      "properties": {
        "tax_breaks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "corporate_tax_reduction",
                  "rd_tax_credit",
                  "property_tax_holiday",
                  "payroll_tax_credit",
                  "capital_tax_exemption",
                  "ip_tax_reduction"
                ]
              },
              "rate_reduction": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "Percentage reduction (e.g., 50 for 50%)"
              },
              "duration_years": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20,
                "description": "Duration in years"
              },
              "max_amount_usd": {
                "type": "number",
                "minimum": 0,
                "description": "Maximum amount in USD"
              },
              "cap_amount_usd": {
                "type": "number",
                "minimum": 0,
                "description": "Cap amount in USD"
              },
              "eligibility_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "List of eligibility criteria"
              },
              "application_deadline": {
                "type": ["string", "null"],
                "format": "date",
                "description": "Application deadline"
              },
              "stackable": {
                "type": "boolean",
                "description": "Whether this incentive can be stacked with others"
              }
            },
            "required": ["type", "rate_reduction", "duration_years"]
          }
        },
        "subsidies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "rd_subsidy",
                  "equipment_subsidy",
                  "salary_subsidy",
                  "training_subsidy",
                  "infrastructure_subsidy",
                  "startup_capital",
                  "scaling_grant",
                  "pilot_program_funding"
                ]
              },
              "amount_usd": {
                "type": "number",
                "minimum": 0,
                "description": "Amount in USD"
              },
              "currency": {
                "type": "string",
                "default": "USD",
                "description": "Currency code"
              },
              "purpose": {
                "type": "string",
                "description": "Purpose of the subsidy"
              },
              "duration_months": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "description": "Duration in months"
              },
              "milestone_based": {
                "type": "boolean",
                "description": "Whether subsidy is paid based on milestones"
              },
              "milestones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "milestone_name": {
                      "type": "string"
                    },
                    "amount_usd": {
                      "type": "number"
                    },
                    "completion_criteria": {
                      "type": "string"
                    }
                  }
                }
              },
              "eligibility_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "List of eligibility criteria"
              },
              "application_deadline": {
                "type": ["string", "null"],
                "format": "date",
                "description": "Application deadline"
              }
            },
            "required": ["type", "amount_usd", "purpose"]
          }
        },
        "land_grants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "land_lease",
                  "land_purchase",
                  "land_grant",
                  "building_concession",
                  "facility_subsidy",
                  "lab_space_grant"
                ]
              },
              "area_sqm": {
                "type": "number",
                "minimum": 0,
                "description": "Area in square meters"
              },
              "rental_rate_per_sqm": {
                "type": "number",
                "minimum": 0,
                "description": "Rental rate per square meter per year"
              },
              "duration_years": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30,
                "description": "Duration in years"
              },
              "location": {
                "type": "string",
                "description": "Specific location within jurisdiction"
              },
              "infrastructure_included": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "lab_equipment",
                    "internet_connectivity",
                    "utilities",
                    "security_systems",
                    "conference_facilities",
                    "data_centers",
                    "clean_rooms"
                  ]
                },
                "description": "Infrastructure included"
              },
              "customization_allowed": {
                "type": "boolean",
                "description": "Whether space can be customized"
              }
            },
            "required": ["type", "area_sqm", "duration_years"]
          }
        },
        "non_financial_benefits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "benefit_type": {
                "type": "string",
                "enum": [
                  "fast_track_approval",
                  "regulatory_exemption",
                  "market_access",
                  "talent_acquisition",
                  "supply_chain_integration",
                  "branding_benefits",
                  "network_access",
                  "mentorship_program",
                  "industry_connections",
                  "ip_protection",
                  "export_support",
                  "immigration_benefits"
                ]
              },
              "description": {
                "type": "string"
              },
              "value_usd": {
                "type": "number",
                "minimum": 0,
                "description": "Estimated monetary value of the benefit"
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "staffing": {
          "type": "object",
          "properties": {
            "min_employees": {
              "type": "integer",
              "minimum": 0,
              "description": "Minimum number of employees"
            },
            "min_researchers": {
              "type": "integer",
              "minimum": 0,
              "description": "Minimum number of research staff"
            },
            "phd_percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Minimum percentage of PhD holders"
            },
            "experience_years": {
              "type": "integer",
              "minimum": 0,
              "description": "Minimum years of experience required"
            },
            "salary_threshold_usd": {
              "type": "number",
              "minimum": 0,
              "description": "Minimum salary threshold"
            },
            "skill_requirements": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Required skills (e.g., ['machine_learning', 'quantum_physics'])"
            }
          }
        },
        "intellectual_property": {
          "type": "object",
          "properties": {
            "min_patents": {
              "type": "integer",
              "minimum": 0,
              "description": "Minimum number of patents"
            },
            "patent_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "invention",
                  "utility",
                  "design",
                  "plant",
                  "software_patent",
                  "method_patent"
                ]
              },
              "description": "Required types of patents"
            },
            "min_trademarks": {
              "type": "integer",
              "minimum": 0,
              "description": "Minimum number of trademarks"
            },
            "copyrights_required": {
              "type": "boolean",
              "description": "Whether copyrights are required"
            },
            "ip_ownership": {
              "type": "string",
              "enum": ["company_owned", "joint_ownership", "research_institute"],
              "description": "IP ownership requirements"
            }
          }
        },
        "financial": {
          "type": "object",
          "properties": {
            "min_investment_usd": {
              "type": "number",
              "minimum": 0,
              "description": "Minimum investment required"
            },
            "min_revenue_usd": {
              "type": "number",
              "minimum": 0,
              "description": "Minimum annual revenue"
            },
            "rdd_percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Minimum R&D investment percentage"
            },
            "credit_rating": {
              "type": "string",
              "description": "Required credit rating"
            },
            "net_worth_threshold": {
              "type": "number",
              "minimum": 0,
              "description": "Minimum net worth"
            }
          }
        },
        "technical": {
          "type": "object",
          "properties": {
            "tech_stack_requirements": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Required technology stack"
            },
            "certifications_required": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Required certifications"
            },
            "security_clearance": {
              "type": ["string", "null"],
              "description": "Required security clearance level"
            },
            "compliance_standards": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Required compliance standards"
            }
          }
        },
        "location_requirements": {
          "type": "object",
          "properties": {
            "min_area_sqm": {
              "type": "integer",
              "minimum": 0,
              "description": "Minimum required area in square meters"
            },
            "facility_type": {
              "type": "string",
              "enum": [
                "rdd_center",
                "manufacturing",
                "office",
                "mixed_use",
                "lab",
                "testing_facility",
                "pilot_plant",
                "production_facility"
              ]
            },
            "zone_requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "free_trade_zone",
                  "special_economic_zone",
                  "tech_park",
                  "university_park",
                  "industrial_park",
                  "innovation_district",
                  "science_park"
                ]
              }
            }
          }
        }
      }
    },
    "compliance": {
      "type": "object",
      "properties": {
        "data_localization": {
          "type": "boolean",
          "description": "Whether data must be stored locally"
        },
        "export_controls": {
          "type": "boolean",
          "description": "Whether export controls apply"
        },
        "security_clearance": {
          "type": ["string", "null"],
          "description": "Required security clearance level"
        },
        "environmental_standards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required environmental standards"
        },
        "reporting_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "frequency": {
                "type": "string",
                "enum": ["monthly", "quarterly", "annually", "continuous"]
              },
              "report_type": {
                "type": "string"
              },
              "deadline": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "audit_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required audit types"
        },
        "licensing_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required licenses"
        }
      }
    },
    "application_process": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_number": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string"
              },
              "required_documents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "duration_days": {
                "type": "integer",
                "minimum": 0
              },
              "success_criteria": {
                "type": "string"
              }
            }
          }
        },
        "contact_info": {
          "type": "object",
          "properties": {
            "department": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "phone": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "website": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "processing_time_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Typical processing time in days"
        }
      }
    }
  },
  "required": ["policy_metadata", "incentives", "requirements", "compliance"]
}
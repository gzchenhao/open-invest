{
  "openapi": "3.0.0",
  "info": {
    "title": "Open Invest Protocol API",
    "version": "1.0.0",
    "description": "高科技项目方与政府招商局之间的安全合规互联协议"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Development server"
    }
  ],
  "components": {
    "schemas": {
      "JsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "method", "params"],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"]
          },
          "method": {
            "type": "string",
            "description": "API method name"
          },
          "params": {
            "type": "object",
            "description": "Method parameters"
          },
          "id": {
            "type": "string",
            "description": "Request ID"
          }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "required": ["jsonrpc", "result"],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"]
          },
          "result": {
            "type": "object",
            "description": "Response data"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "data": {
                "type": "object"
              }
            }
          },
          "id": {
            "type": "string",
            "description": "Request ID"
          }
        }
      },
      "TechReadinessRequest": {
        "type": "object",
        "required": ["project_id"],
        "properties": {
          "project_id": {
            "type": "string",
            "description": "项目唯一标识符"
          }
        }
      },
      "LandingRequirementsRequest": {
        "type": "object",
        "required": ["location", "industry"],
        "properties": {
          "location": {
            "type": "string",
            "description": "目标地区"
          },
          "industry": {
            "type": "string",
            "description": "行业类型"
          },
          "project_scale": {
            "type": "string",
            "enum": ["small", "medium", "large"],
            "description": "项目规模"
          }
        }
      },
      "EconomicComplianceRequest": {
        "type": "object",
        "required": ["project_id", "region"],
        "properties": {
          "project_id": {
            "type": "string",
            "description": "项目唯一标识符"
          },
          "region": {
            "type": "string",
            "description": "目标地区"
          },
          "compliance_level": {
            "type": "string",
            "enum": ["basic", "standard", "enhanced"],
            "description": "合规级别要求"
          }
        }
      }
    }
  },
  "paths": {
    "/rpc": {
      "post": {
        "summary": "JSON-RPC endpoint",
        "description": "统一的 JSON-RPC 2.0 端点",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}